# Environment template
BACKEND_DEBUG=True
BACKEND_SECRET_KEY=django-insecure-change-me-in-production
BACKEND_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.app.github.dev,.github.dev
BACKEND_JWT_ALGORITHM=HS256

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=turnitin_db
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_HOST=localhost
DB_PORT=5432

# Turnitin Configuration
TURNITIN_API_KEY=your_turnitin_api_key
TURNITIN_API_SECRET=your_turnitin_api_secret
TURNITIN_API_URL=https://api.turnitinapis.com
TURNITIN_INTEGRATION_CODE=your_integration_code

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.app.github.dev
CSRF_TRUSTED_ORIGINS=https://localhost:8000,https://localhost:5173,http://localhost:8000,http://localhost:5173,https://*.app.github.dev

# Redis & Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Sentry (Optional)
SENTRY_DSN=

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
